# Experimental R-free pilot image for the supplied-table HTML route.
#
# Not a production image. It deliberately contains no R, renv, Rscript, knitr or TeX.
# Python installation inputs are hash-checked from a frozen lock; pip/setuptools/wheel are
# installed from a separate hashed bootstrap. The final install/build runs with no network.
# apt package selections remain unpinned; Quarto remains version-pinned without a checksum.
ARG UV_VERSION=0.8.14
FROM ghcr.io/astral-sh/uv:${UV_VERSION}@sha256:d97bc3f40af096399f67e8e69e10b7735f3dbc6fed300391637ecb00f37af981 AS uvbin

# Download every hashed installation input once, in a network-enabled stage. The final image
# receives these artifacts through read-only bind mounts and installs/builds without network.
FROM python:3.11.6-slim-bookworm@sha256:38a28170d13a276d42b7dd55cae54440b581d773549d361d19089ec47d4791c5 AS pilot-wheels
COPY scripts/health_pipeline/requirements.pilot.bootstrap.txt /opt/pilot/requirements.pilot.bootstrap.txt
COPY scripts/health_pipeline/requirements.pilot.lock.txt /opt/pilot/requirements.pilot.lock.txt
RUN python -m pip download --require-hashes --no-cache-dir \
      -r /opt/pilot/requirements.pilot.bootstrap.txt -d /opt/wheels/bootstrap \
    && python -m pip download --require-hashes --no-cache-dir \
      -r /opt/pilot/requirements.pilot.lock.txt -d /opt/wheels/runtime

FROM python:3.11.6-slim-bookworm@sha256:38a28170d13a276d42b7dd55cae54440b581d773549d361d19089ec47d4791c5

ARG QUARTO_VERSION=1.3.353
# B2-QT-1.3.353-LINUX-AMD64: publisher-published checksum from
# quarto-1.3.353-checksums.txt (release id 102832185), same-channel integrity pinning,
# not independent authentication. Overriding either value changes the approved decision.
ARG QUARTO_SHA256=5c34a326f3c9fe5ecba251b1bfe840229524b6db93982478e516fa17af89dde4
ARG QUARTO_BYTES=89745288

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uvbin /uv /uvx /usr/local/bin/

COPY scripts/health_pipeline/requirements.pilot.bootstrap.txt /opt/pilot/requirements.pilot.bootstrap.txt
COPY scripts/health_pipeline/requirements.pilot.lock.txt /opt/pilot/requirements.pilot.lock.txt
COPY assets/fonts/noto-cjk/NotoSansCJKsc-Regular.otf /opt/pilot/fonts/NotoSansCJKsc-Regular.otf
COPY assets/fonts/noto-cjk/LICENSE.txt /opt/pilot/fonts/LICENSE.txt
COPY assets/fonts/noto-cjk/SOURCE.md /opt/pilot/fonts/SOURCE.md

# Bootstrap tools are installed from the hashed wheelhouse without network. --ignore-installed
# prevents pip from treating the base-image copies as satisfied without hash checking.
RUN --network=none \
      --mount=type=bind,from=pilot-wheels,source=/opt/wheels/bootstrap,target=/wheelhouse/bootstrap \
      PIP_NO_INDEX=1 python -m pip install --no-index --find-links=/wheelhouse/bootstrap \
      --require-hashes --ignore-installed -r /opt/pilot/requirements.pilot.bootstrap.txt

# Runtime installation is local-only. connection-pool==0.0.3 is the sole source distribution;
# --no-build-isolation uses the hashed bootstrap tools, and PIP_NO_INDEX blocks legacy fetches.
RUN --network=none \
      --mount=type=bind,from=pilot-wheels,source=/opt/wheels/runtime,target=/wheelhouse/runtime \
      PIP_NO_INDEX=1 PIP_NO_BUILD_ISOLATION=1 python -m pip install --no-index \
      --find-links=/wheelhouse/runtime --require-hashes --no-build-isolation \
      -r /opt/pilot/requirements.pilot.lock.txt \
    && python -m pip check \
    && python -c "import matplotlib, pandas, sys; assert sys.version_info[:3] == (3, 11, 6); print(matplotlib.__version__)"

# Quarto: publisher-published checksum (B2 decision). Verify size and SHA-256 before extraction;
# the expected checksum is tracked here, never fetched dynamically during the build.
RUN set -eu; \
    case "${QUARTO_SHA256}" in \
      ''|*[!0-9a-f]*) echo "Invalid QUARTO_SHA256" >&2; exit 1 ;; \
    esac; \
    [ "${#QUARTO_SHA256}" -eq 64 ] || { echo "Invalid QUARTO_SHA256 length" >&2; exit 1; }; \
    archive="/tmp/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz"; \
    curl --fail --show-error --location \
      --retry 5 --retry-all-errors --retry-delay 3 \
      --connect-timeout 30 --max-time 600 \
      "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" \
      -o "$archive"; \
    [ "$(stat -c%s "$archive")" -eq "${QUARTO_BYTES}" ] || { echo "Quarto archive size mismatch" >&2; exit 1; }; \
    printf '%s  %s\n' "$QUARTO_SHA256" "quarto-${QUARTO_VERSION}-linux-amd64.tar.gz" > /tmp/quarto.expected; \
    (cd /tmp && sha256sum -c quarto.expected); \
    mkdir -p /opt/quarto; \
    tar -xzf "$archive" -C /opt/quarto --strip-components=1; \
    ln -s /opt/quarto/bin/quarto /usr/local/bin/quarto; \
    rm "$archive" /tmp/quarto.expected

WORKDIR /app
CMD ["python"]

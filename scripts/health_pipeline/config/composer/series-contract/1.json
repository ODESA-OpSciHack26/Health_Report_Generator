{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health-report/series-component/1",
  "title": "Composer contract for one saved annual series block, version 1",
  "description": "Structural contract only. Agreement with the saved bundle, artifact integrity and row-level binding are checked in a separate read-only layer.",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,39}$"
    },
    "artifact_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "metric_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?::[a-z0-9_]+)+$"
    },
    "saved_number": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_type",
        "years",
        "reference_year",
        "index_base_year",
        "geography",
        "measures_preferred",
        "compare_by",
        "classes_in_main_comparison",
        "exclude_from_group_totals",
        "sensitivity_exclude",
        "source_priority",
        "group_source_systems",
        "dimension_filters"
      ],
      "properties": {
        "period_type": { "type": "string" },
        "years": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer" }
        },
        "reference_year": { "type": "integer" },
        "index_base_year": { "type": "integer" },
        "geography": { "enum": ["CH", "CHFL"] },
        "measures_preferred": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["cases", "consultations"] }
        },
        "compare_by": { "type": "string" },
        "classes_in_main_comparison": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["viral", "bacterial"] }
        },
        "exclude_from_group_totals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "include_topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude_topics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sensitivity_exclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_priority": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "group_source_systems": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dimension_filters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["values", "reason"],
            "properties": {
              "values": { "type": "object" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "code_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "$ref": "#/$defs/artifact_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "component",
        "instance_id",
        "analysis",
        "selection",
        "periods",
        "observations",
        "missing_years",
        "artifact",
        "implementation",
        "presentation"
      ],
      "properties": {
        "contract": { "const": "health-report/series-component/1" },
        "instance_id": { "$ref": "#/$defs/identifier" },
        "component": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "version"],
          "properties": {
            "type": { "const": "series-trend" },
            "version": { "const": "1" }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshot_id", "scope"],
          "properties": {
            "snapshot_id": { "$ref": "#/$defs/sha256" },
            "scope": { "$ref": "#/$defs/scope" }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topic", "measure", "geography", "dataset_id", "source_system"],
          "properties": {
            "topic": { "type": "string", "minLength": 1 },
            "measure": { "type": "string", "minLength": 1 },
            "geography": { "enum": ["CH", "CHFL"] },
            "dataset_id": { "type": "string", "minLength": 1 },
            "source_system": { "type": "string", "minLength": 1 }
          }
        },
        "periods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "effective", "reference_year", "reference_outside_window"],
          "properties": {
            "requested": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "integer" }
            },
            "effective": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer" }
            },
            "reference_year": { "type": "integer" },
            "reference_outside_window": { "type": "boolean" }
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["year", "count_metric_id", "value", "unit"],
            "properties": {
              "year": { "type": "integer" },
              "count_metric_id": { "$ref": "#/$defs/metric_id" },
              "value": { "$ref": "#/$defs/saved_number" },
              "unit": { "type": "string", "minLength": 1 }
            }
          }
        },
        "missing_years": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "digest"],
          "properties": {
            "file": { "$ref": "#/$defs/artifact_path" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["analysis", "presentation"],
          "properties": {
            "analysis": { "$ref": "#/$defs/code_reference" },
            "presentation": { "$ref": "#/$defs/code_reference" },
            "contracts": { "$ref": "#/$defs/code_reference" },
            "binding": { "$ref": "#/$defs/code_reference" },
            "schema": { "$ref": "#/$defs/code_reference" }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit"],
          "properties": {
            "unit": { "type": "string", "minLength": 1 },
            "style": { "enum": ["standard", "compact"] }
          }
        }
      }
    }
  }
}
